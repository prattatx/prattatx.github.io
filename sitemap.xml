---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign pages = site.pages | where_exp: "p", "p.sitemap != false" %}
  {% for p in pages %}{% if p.url contains '.html' or p.url contains '.xml' or p.url contains '.txt' %}{% else %}
  <url><loc>{{ site.url }}{{ p.url }}</loc></url>
  {% endif %}{% endfor %}
  {% for post in site.posts %}
  <url><loc>{{ site.url }}{{ post.url }}</loc><lastmod>{{ post.date | date_to_xmlschema }}</lastmod></url>
  {% endfor %}
</urlset>
